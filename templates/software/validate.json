{
  "//": "Independent commit gate. The supervisor runs this itself after the agent claims success; nothing is committed unless every command exits 0. Tokens: __PY__ = the supervisor's Python, __CHANGED_DIRS__ = one run per changed directory. Replace the TODO command with the project's test suite. The scope check and the dangling reference check (integrity/integrity.py gate / refs; settings in the config's scope and refs sections) and then the adversary run last, in that order, only if everything before them passed; the adversary can only veto (exit 3), settings in the config's adversary section.",
  "suspicious": {
    "//": "Changed files matching deny_globs (and not allow_globs), or over max_file_mb, block the commit.",
    "max_file_mb": 5,
    "deny_globs": [
      "**/.env",
      "**/.claude/**",
      "**/.mcp.json",
      "**/*.bak",
      "**/*.bak-*",
      "**/*.orig",
      "**/.env.*",
      "**/*.pem",
      "**/*.p12",
      "**/*.pfx",
      "**/*.key",
      "**/id_rsa",
      "**/id_ed25519",
      "**/credentials",
      "**/secrets*.json",
      "**/node_modules/**",
      "**/vendor/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/*.log"
    ],
    "allow_globs": [
      "**/.env.example",
      "**/.env.sample",
      "**/.env.template"
    ]
  },
  "always": [
    {
      "label": "whitespace/conflict-marker check",
      "argv": [
        "git",
        "diff",
        "--check"
      ]
    },
    {
      "label": "TODO: project test suite",
      "argv": [
        "TODO-test-command",
        "arg"
      ]
    },
    {
      "label": "scope check",
      "skip_if_failed": true,
      "timeout_minutes": 5,
      "argv": [
        "__PY__",
        "__HARNESS__/../integrity/integrity.py",
        "gate",
        "--config",
        "__PROJECT_CONFIG__",
        "--repo",
        "."
      ]
    },
    {
      "label": "dangling reference check",
      "skip_if_failed": true,
      "timeout_minutes": 5,
      "argv": [
        "__PY__",
        "__HARNESS__/../integrity/integrity.py",
        "refs",
        "--config",
        "__PROJECT_CONFIG__",
        "--repo",
        "."
      ]
    },
    {
      "label": "adversarial review (veto-only)",
      "skip_if_failed": true,
      "timeout_minutes": 5,
      "argv": [
        "__PY__",
        "__HARNESS__/adversary.py",
        "--config",
        "__PROJECT_CONFIG__",
        "--repo",
        ".",
        "--diff"
      ]
    }
  ],
  "rules": [
    {
      "when_touched": [
        "**/*.py"
      ],
      "commands": [
        {
          "label": "python compileall (changed dirs)",
          "argv": [
            "__PY__",
            "-m",
            "compileall",
            "-q",
            "__CHANGED_DIRS__"
          ]
        }
      ]
    }
  ]
}
